{
  "schema_version": 1,
  "dimensions": {
    "hook": {
      "label": "首屏结论力",
      "weight": 18
    },
    "chunk": {
      "label": "分块粒度",
      "weight": 18
    },
    "scan": {
      "label": "扫读性",
      "weight": 13
    },
    "sentence": {
      "label": "句子负荷",
      "weight": 13
    },
    "action": {
      "label": "行动性",
      "weight": 12
    },
    "typo": {
      "label": "排版一致性",
      "weight": 13
    },
    "human": {
      "label": "活人感",
      "weight": 13
    }
  },
  "global_score_cap": 20,
  "thresholds": {
    "language": {
      "en": {
        "para": 80,
        "section": 200,
        "sent_mean": 20,
        "sent_p90": 30,
        "tldr": 120,
        "frag": 25
      },
      "zh": {
        "para": 160,
        "section": 400,
        "sent_mean": 45,
        "sent_p90": 70,
        "tldr": 120,
        "frag": 40
      }
    },
    "limits": {
      "L6": {
        "max_items": 7
      },
      "N1": {
        "max_lines_without_toc": 80
      },
      "N5": {
        "max_columns": 5,
        "max_rows": 10
      },
      "C3": {
        "min_units": 45,
        "min_commas": 4
      },
      "C5": {
        "min_de_count": 3
      },
      "T2": {
        "max_bold_ratio": 0.08,
        "max_bold_per_paragraph": 2
      },
      "X2": {
        "min_lines_per_heading": 5,
        "min_plain_prose_sections": 3
      },
      "X5": {
        "max_bold_ratio": 0.12
      },
      "M5": {
        "dashes_per_thousand_han": 8
      },
      "S7": {
        "min_lines": 600
      },
      "N3": {
        "min_h2_sections": 2
      },
      "H1": {
        "max_lines": 15,
        "max_summary_sentences": 3,
        "max_summary_units": {
          "en": 40,
          "zh": 80
        }
      },
      "H2": {
        "max_items": 5
      },
      "P1": {
        "max_sentences": 3
      },
      "L1": {
        "max_depth": 2
      },
      "L3": {
        "min_items": 3
      },
      "L5": {
        "max_lines": 2
      },
      "M13": {
        "number_context": 10
      },
      "M14": {
        "min_chain_count": 2
      },
      "P4": {
        "max_consecutive_lines": 6
      }
    }
  },
  "rules": [
    {
      "id": "S1",
      "group": "S",
      "name": "标题不跳级",
      "axis": "F",
      "min_level": 1,
      "automation": "det",
      "status": "audit",
      "threshold": "H1→H3 直接跳，插入或降级修正",
      "evidence_group": "S",
      "scoring": [
        {
          "id": "S1",
          "dimension": "typo",
          "points": 10,
          "cap": 30,
          "label": "标题跳级",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "S1"
      ]
    },
    {
      "id": "S2",
      "group": "S",
      "name": "全文唯一 H1",
      "axis": "F",
      "min_level": 1,
      "automation": "det",
      "status": "audit",
      "threshold": "H1 数量 = 1",
      "evidence_group": "S",
      "scoring": [
        {
          "id": "S2",
          "dimension": "typo",
          "points": 10,
          "cap": 10,
          "label": "H1 数量 ≠ 1",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "S2"
      ]
    },
    {
      "id": "S3",
      "group": "S",
      "name": "两个标题之间正文不超上限",
      "axis": "F",
      "min_level": 2,
      "automation": "lint",
      "status": "audit",
      "threshold": "≤200 词 / ≤400 字",
      "evidence_group": "S",
      "scoring": [
        {
          "id": "S3",
          "dimension": "chunk",
          "points": 10,
          "cap": 40,
          "label": "章节超限：两标题间 >200 词 / >400 字",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "S3"
      ]
    },
    {
      "id": "S4",
      "group": "S",
      "name": "标题写结论，不写话题",
      "axis": "C",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "「安装」→「用 npm 一行装好」",
      "evidence_group": "S",
      "scoring": []
    },
    {
      "id": "S5",
      "group": "S",
      "name": "结论/答案块前置",
      "axis": "F",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "搬移已有块，不新写",
      "evidence_group": "S",
      "scoring": []
    },
    {
      "id": "S6",
      "group": "S",
      "name": "章节顺序符合文档类型骨架",
      "axis": "F",
      "min_level": 3,
      "automation": "judge",
      "status": "judge",
      "threshold": "见 `doc-types.md`",
      "evidence_group": "S",
      "scoring": []
    },
    {
      "id": "S7",
      "group": "S",
      "name": "超长单文件建议拆分",
      "axis": "F",
      "min_level": 3,
      "automation": "lint",
      "status": "advisory",
      "threshold": ">600 行时给拆分建议，不自动拆",
      "evidence_group": "S",
      "scoring": [],
      "finding_ids": [
        "S7"
      ]
    },
    {
      "id": "S8",
      "group": "S",
      "name": "每节开头一句话交代本节解决什么",
      "axis": "C",
      "min_level": 3,
      "automation": "judge",
      "status": "judge",
      "threshold": "标题下第一句",
      "evidence_group": "S",
      "scoring": []
    },
    {
      "id": "H1",
      "group": "H",
      "name": "前 15 行内出现结论 / TL;DR",
      "axis": "C",
      "min_level": 2,
      "automation": "det/lint",
      "status": "audit",
      "threshold": "原文已有结论段则搬移（转 F 轴，走 S5）",
      "evidence_group": "H",
      "scoring": [
        {
          "id": "H1",
          "dimension": "hook",
          "points": 60,
          "cap": 60,
          "label": "前 15 行无结论 / TL;DR",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "H1"
      ]
    },
    {
      "id": "H2",
      "group": "H",
      "name": "TL;DR 控制长度",
      "axis": "C",
      "min_level": 2,
      "automation": "lint",
      "status": "audit",
      "threshold": "≤5 条且 ≤120 字",
      "evidence_group": "H",
      "scoring": [
        {
          "id": "H2",
          "dimension": "hook",
          "points": 15,
          "cap": 15,
          "label": "TL;DR 超长：>5 条或 >120 字",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "H2"
      ]
    },
    {
      "id": "H3",
      "group": "H",
      "name": "首屏声明「读完你能做到什么」",
      "axis": "C",
      "min_level": 3,
      "automation": "judge",
      "status": "judge",
      "threshold": "一句话，写读者收益不写文档结构",
      "evidence_group": "H",
      "scoring": [
        {
          "id": "H3",
          "dimension": "hook",
          "points": 15,
          "cap": 15,
          "label": "首屏无「读完你能做到什么」（仅 deep）",
          "mode": "per_finding"
        }
      ]
    },
    {
      "id": "H4",
      "group": "H",
      "name": "首屏给时间/篇幅预估",
      "axis": "C",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "`约 5 分钟` / `3 步`",
      "evidence_group": "H",
      "scoring": [
        {
          "id": "H4",
          "dimension": "hook",
          "points": 10,
          "cap": 10,
          "label": "首屏无时间/篇幅预估",
          "mode": "per_finding"
        }
      ]
    },
    {
      "id": "P1",
      "group": "P",
      "name": "段落长度上限",
      "axis": "F",
      "min_level": 1,
      "automation": "lint",
      "status": "audit",
      "threshold": "≤3 句 **且** ≤80 词 / ≤160 字",
      "evidence_group": "P/L/W",
      "scoring": [
        {
          "id": "P1",
          "dimension": "chunk",
          "points": 8,
          "cap": 60,
          "label": "段落超限：>3 句或 >80 词 / >160 字",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "P1"
      ]
    },
    {
      "id": "P2",
      "group": "P",
      "name": "一段只讲一件事",
      "axis": "F",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "出现话题转折即拆",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "P3",
      "group": "P",
      "name": "块级元素之间留空行",
      "axis": "F",
      "min_level": 1,
      "automation": "det",
      "status": "format",
      "threshold": "标题/列表/代码块前后各一空行",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "P4",
      "group": "P",
      "name": "连续密集行强制切分",
      "axis": "F",
      "min_level": 1,
      "automation": "lint",
      "status": "audit",
      "threshold": ">6 行无空行且无列表/标题标记",
      "evidence_group": "P/L/W",
      "scoring": [
        {
          "id": "P4",
          "dimension": "chunk",
          "points": 10,
          "cap": 30,
          "label": "密集行块：>6 行无空行且无标记",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "P4"
      ]
    },
    {
      "id": "P5",
      "group": "P",
      "name": "超长引用块拆分或折叠",
      "axis": "F",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": ">5 行的 `>` 块",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "L1",
      "group": "L",
      "name": "嵌套不超两层",
      "axis": "F",
      "min_level": 1,
      "automation": "lint",
      "status": "audit",
      "threshold": "三层起压平或提为小节",
      "evidence_group": "P/L/W",
      "scoring": [
        {
          "id": "L1",
          "dimension": "scan",
          "points": 10,
          "cap": 30,
          "label": "列表嵌套 ≥3 层",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "L1"
      ]
    },
    {
      "id": "L2",
      "group": "L",
      "name": "可枚举的并列句转列表",
      "axis": "F",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "复用原词，不改写",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "L3",
      "group": "L",
      "name": "步骤用有序列表；可追踪的用 `- [ ]`",
      "axis": "F",
      "min_level": 2,
      "automation": "det/lint",
      "status": "audit",
      "threshold": "操作步骤禁用无序列表",
      "evidence_group": "P/L/W",
      "scoring": [
        {
          "id": "L3",
          "dimension": "scan",
          "points": 12,
          "cap": 12,
          "label": "步骤用无序列表",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "L3"
      ]
    },
    {
      "id": "L4",
      "group": "L",
      "name": "列表项平行结构",
      "axis": "C",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "同词性开头，动词统一时态",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "L5",
      "group": "L",
      "name": "单个列表项不超两行",
      "axis": "F",
      "min_level": 2,
      "automation": "lint",
      "status": "audit",
      "threshold": "超出则提为小节",
      "evidence_group": "P/L/W",
      "scoring": [
        {
          "id": "L5",
          "dimension": "scan",
          "points": 4,
          "cap": 20,
          "label": "列表项 >2 行",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "L5"
      ]
    },
    {
      "id": "L6",
      "group": "L",
      "name": "超七项分组加小标题",
      "axis": "F",
      "min_level": 2,
      "automation": "lint",
      "status": "advisory",
      "threshold": ">7 项",
      "evidence_group": "P/L/W",
      "scoring": [],
      "finding_ids": [
        "L6"
      ]
    },
    {
      "id": "L7",
      "group": "L",
      "name": "列表项保持完整语义",
      "axis": "C",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "见 X3 反模式",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "W1",
      "group": "W",
      "name": "句长上限",
      "axis": "C",
      "min_level": 2,
      "automation": "lint",
      "status": "audit",
      "threshold": "均值 ≤20 词 / ≤45 字；**单句** ≤30 词 / ≤70 字",
      "evidence_group": "P/L/W",
      "scoring": [
        {
          "id": "W1m",
          "dimension": "sentence",
          "points": 15,
          "cap": 50,
          "label": "均句长每超阈值 10%",
          "mode": "per_finding"
        },
        {
          "id": "W1x",
          "dimension": "sentence",
          "points": 8,
          "cap": 32,
          "label": "单句超长：>30 词 / >70 字",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "W1m",
        "W1x"
      ]
    },
    {
      "id": "W2",
      "group": "W",
      "name": "主动语态",
      "axis": "C",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "被动句占比 ≤10%",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "W3",
      "group": "W",
      "name": "括号插入语拆出或删除",
      "axis": "C",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "句中括号内容 >5 词",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "W4",
      "group": "W",
      "name": "消灭回扫指令",
      "axis": "C",
      "min_level": 2,
      "automation": "lint",
      "status": "audit",
      "threshold": "`如上所述` `见下文` `前面提到` `as mentioned above` → 就地重述",
      "evidence_group": "P/L/W",
      "scoring": [
        {
          "id": "W4",
          "dimension": "sentence",
          "points": 8,
          "cap": 24,
          "label": "回扫指令",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "W4"
      ]
    },
    {
      "id": "W5",
      "group": "W",
      "name": "术语首现即解释",
      "axis": "C",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "缩写第一次出现处",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "W6",
      "group": "W",
      "name": "删填充词",
      "axis": "C",
      "min_level": 2,
      "automation": "lint",
      "status": "audit",
      "threshold": "`基本上` `事实上` `需要注意的是` `值得一提的是` `其实`",
      "evidence_group": "P/L/W",
      "scoring": [
        {
          "id": "W6",
          "dimension": "sentence",
          "points": 2,
          "cap": 16,
          "label": "填充词",
          "mode": "per_finding"
        }
      ],
      "finding_ids": [
        "W6"
      ]
    },
    {
      "id": "W7",
      "group": "W",
      "name": "第二人称 + 现在时 + 具体动词",
      "axis": "C",
      "min_level": 3,
      "automation": "judge",
      "status": "judge",
      "threshold": "「用户应当配置」→「你配置」",
      "evidence_group": "P/L/W",
      "scoring": []
    },
    {
      "id": "W8",
      "group": "W",
      "name": "一句一从句",
      "axis": "C",
      "min_level": 2,
      "automation": "judge",
      "status": "judge",
      "threshold": "禁三层嵌套从句",
