+    def test_bold_does_not_pair_across_blocks(self):
+        doc = Doc("# Title\n\n**unclosed paragraph\n\nother paragraph**\n")
+        self.assertFalse({"T2d", "X5"} & {f.rule for f in audit(doc)})
