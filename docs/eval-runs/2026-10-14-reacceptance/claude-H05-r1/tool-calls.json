      "file_path": "/tmp/h05-scratch/diagnostics.py",
      "content": "\"\"\"Diagnostics: heading density, prose-section units (X2 inputs) and bold density (T2/X5).\"\"\"\nimport re\nimport sys\n\nsys.path.insert(0, \"/private/tmp/adhd-reacceptance-20261014/claude-H05-r1/workspace\"\n                   \"/.agents/skills/adhd-md/scripts\")\nimport adhd_md as m  # noqa: E402\n\nCHECKBOX = re.compile(r\"^\\s*[-*+]\\s+\\[[ xX]\\]\", re.M)\n\nfor path in sys.argv[1:]:\n    text = open(path, encoding=\"utf-8\").read()\n    doc = m.Doc(text)\n    blocks = doc.blocks\n    headings = [b for b in blocks if b.kind == \"heading\"]\n    # X2 part 1: lines per heading (limit: must be >= 5)\n    lph = len(doc.lines) / len(headings) if headings else None\n    # X2 part 2: pure-prose sections (same walk as the auditor)\n    prose_secs, cur, structured, started = [], 0, False, False\n    for b in blocks:\n        if b.kind == \"heading\":\n            if started and not structured:\n                prose_secs.append(cur)\n            cur, structured, started = 0, False, True\n            continue\n        if b.kind == \"code\" or (b.kind == \"list\" and CHECKBOX.search(b.text)):\n            structured = True\n        cur += m.units(m.prose_of(b), \"zh\")\n    if started and not structured:\n        prose_secs.append(cur)\n    # T2 / X5: bold density over body prose\n    stats = [m.bold_metrics(b) for b in blocks]\n    bold = sum(s[0] for s in stats)\n    total = max(1, sum(s[1] for s in stats))\n    print(f\"{path}\")\n    print(f\"  headings={len(headings)} lines={len(doc.lines)} lines/heading={lph:.1f} (limit 5)\")\n    print(f\"  prose_sections={prose_secs} count={len(prose_secs)} (needs >=3 to fire)\")\n    print(f\"  bold_chars={bold} body_chars={total} ratio={bold / total:.2%} \"\n          f\"(T2 limit 8%, X5 limit 12%)\")\n"
    }
  },
