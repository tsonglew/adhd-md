---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Sessions from "../components/Sessions.astro";
import Reading from "../components/Reading.astro";
import Compare from "../components/Compare.astro";
import Scope from "../components/Scope.astro";
import Human from "../components/Human.astro";
import Lossless from "../components/Lossless.astro";
import Eval from "../components/Eval.astro";
import Hosts from "../components/Hosts.astro";
import Start from "../components/Start.astro";
import { ui } from "../i18n/ui";

const t = ui.zh;
---

<Layout t={t}>
  <Hero t={t} />
  <Reading t={t} />
  <Sessions t={t} />
  <Compare t={t} />
  <Scope t={t} />
  <Lossless t={t} />
  <div class="wrap detail-band">
    <Problem t={t} />
    <Human t={t} />
    <Eval t={t} />
  </div>
  <Hosts t={t} />
  <Start t={t} />
</Layout>
