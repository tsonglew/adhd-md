---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<section class="band" id="hosts">
  <div class="wrap sec">
    <span class="num">06</span>
    <div class="sec-body">
      <h2>{t.hosts.h2}</h2>
      <p class="sub" set:html={t.hosts.subHtml} />

      <ul class="hosts">
        {t.hosts.items.map((h) => (
          <li>
            <b>{h.name}</b>
            <code>{h.path}</code>
            <span class:list={["badge", { live: h.live }]}>{h.badge}</span>
          </li>
        ))}
      </ul>

      <div class="note">
        <p>{t.hosts.note}</p>
        <p class="small">
          {t.hosts.noteSmall}
          <a href="https://github.com/tsonglew/adhd-md/blob/main/docs/eval.md">{t.hosts.noteLink}</a>
          {t.hosts.noteSmallAfter}
        </p>
      </div>
    </div>
  </div>
</section>
