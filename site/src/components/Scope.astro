---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<section class="band" id="scope">
  <div class="wrap sec">
    <span class="num">03</span>
    <div class="sec-body">
      <h2>{t.scope.h2}</h2>
      <p class="sub">
        {t.scope.sub}
      </p>

      <div class="cards">
        {t.scope.cards.map((card) => (
          <article class="card">
            <h3><code>{card.name}</code>{card.tag && <span class="tag">{card.tag}</span>}</h3>
            <p class="card-lede">{card.lede}</p>
            <p class="can">{card.can}</p>
            <p set:html={card.canTextHtml ?? card.canText} />
            <p class="cant">{card.cant}</p>
            <p>{card.cantText}</p>
            <p class="seal">{card.seal}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
