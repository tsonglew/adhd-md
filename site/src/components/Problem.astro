---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<section class="band" id="problem">
  <div class="wrap sec">
    <span class="num">01</span>
    <div class="sec-body">
      <h2>{t.problem.h2}</h2>

      <p class="sub">
        {t.problem.sub}
      </p>

      <div class="wall-demo">
        <div class="wall">
          <p>{t.problem.wall}</p>
          <span class="proof-mark" aria-hidden="true">
            <span class="proof-line"></span>
            <span class="proof-note">{t.problem.proof[0]}<br>{t.problem.proof[1]}</span>
          </span>
        </div>
      </div>

      <ul class="cost">
        {t.problem.cost.map((item) => (
          <li><span class="k">{item.k}</span>{item.t}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
