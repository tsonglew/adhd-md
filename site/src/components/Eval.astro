---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<details class="reference-panel" id="eval">
  <summary>{t.eval.h2}</summary>
  <div class="reference-content">
      <p class="sub" set:html={t.eval.subHtml} />

      <div class="table-scroll" tabindex="0" role="region" aria-label={t.eval.h2}><table class="tax">
        <thead><tr>{t.eval.head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {t.eval.rows.map((row) => (
            <tr><td>{row.doc}</td><td>{row.level}</td><td>{row.score}</td><td>{row.h4}</td></tr>
          ))}
        </tbody>
      </table></div>

      <div class="grid-2">
        {t.eval.findings.map((f) => (
          <div>
            <h3>{f.h}</h3>
            <p set:html={f.t} />
          </div>
        ))}
      </div>

      <p class="small">
        <a href={t.eval.linkHref}>{t.eval.link}</a>
      </p>
  </div>
</details>
