---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<section class="band alt" id="start">
  <div class="wrap sec">
    <span class="num">08</span>
    <div class="sec-body">
      <h2>{t.start.h2}</h2>

      <ol class="steps">
        <li>
          <p>{t.start.s1}</p>
          <p class="way">{t.start.wayNode}</p>
          <div class="cmd sm">
            <code id="c1">npx github:tsonglew/adhd-md</code>
            <button type="button" class="copy" data-copy="#c1" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
          <p class="way">{t.start.wayNoNode}</p>
          <div class="cmd sm">
            <code id="c1b">curl -fsSL https://tsonglew.github.io/adhd-md/install.sh | bash</code>
            <button type="button" class="copy" data-copy="#c1b" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
          <p class="way">{t.start.waySource}</p>
          <div class="cmd sm">
            <code id="c1c">git clone https://github.com/tsonglew/adhd-md &amp;&amp; cd adhd-md
bash scripts/install.sh</code>
            <button type="button" class="copy" data-copy="#c1c" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
          <p class="note-sm" set:html={t.start.noteSmHtml} />
        </li>
        <li>
          <p>{t.start.s2}</p>
          <div class="cmd sm">
            <code id="c2">npx github:tsonglew/adhd-md audit your-doc.md</code>
            <button type="button" class="copy" data-copy="#c2" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
        </li>
        <li>
          <p>{t.start.s3}</p>
          <blockquote>{t.start.quote}</blockquote>
        </li>
      </ol>

      <div class="reading-start">
        <h3>{t.start.readingH}</h3>
        <p>{t.start.readingIntro}</p>
        <blockquote>{t.start.readingQuote}</blockquote>
        <p>{t.start.readingPage}</p>
        <div class="cmd sm">
          <code id="read-command">{t.start.readingCmd}</code>
        </div>
        <p class="reading-note">{t.start.readingNote}</p>
        <details class="extraction-setup">
          <summary>{t.start.extractionH}</summary>
          <p>{t.start.extractionNote}</p>
          <p class="way">{t.start.extractionMac}</p>
          <div class="cmd sm"><code>brew install poppler tesseract tesseract-lang</code></div>
          <p class="way">{t.start.extractionLinux}</p>
          <div class="cmd sm"><code>sudo apt install poppler-utils tesseract-ocr tesseract-ocr-chi-sim</code></div>
          <p class="reading-note">{t.start.extractionLimit}</p>
        </details>
        <p class="reading-note">{t.start.extractionCmd}</p>
      </div>

      <div class="grid-2 tail">
        <div>
          <h3>{t.start.ciH}</h3>
          <div class="cmd sm">
            <code id="c3">{t.start.ciCmd}</code>
            <button type="button" class="copy" data-copy="#c3" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
        </div>
        <div>
          <h3>{t.start.noShellH}</h3>
          <p set:html={t.start.noShellHtml} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reading-start { max-width: 44rem; border-top: 1px solid var(--rule); margin-top: 2rem; padding-top: 1.6rem; }
  .reading-start p { color: var(--ink-2); font-size: .92rem; margin-block: .7rem; }
  .reading-start blockquote { margin: 1rem 0 1.4rem; border-left: 2px solid var(--ok); padding: .65rem 1rem; background: var(--paper); }
  .reading-start .reading-note { font-size: .84rem; max-width: 39rem; overflow-wrap: anywhere; }
  .extraction-setup { margin: 1rem 0; border-block: 1px solid var(--rule); padding: .85rem 0; }
  .extraction-setup summary { cursor: pointer; font-size: .9rem; }
  .extraction-setup summary:focus-visible { outline: 2px solid var(--ok); outline-offset: 4px; }
</style>
