---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<section class="band alt" id="start">
  <div class="wrap sec">
    <span class="num">07</span>
    <div class="sec-body">
      <h2>{t.start.h2}</h2>

      <ol class="steps">
        <li>
          <p>{t.start.s1}</p>
          <p class="way">{t.start.wayNode}</p>
          <div class="cmd sm">
            <code id="c1">npx github:tsonglew/adhd-md</code>
            <button type="button" class="copy" data-copy="#c1" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
          <p class="way">{t.start.wayNoNode}</p>
          <div class="cmd sm">
            <code id="c1b">curl -fsSL https://tsonglew.github.io/adhd-md/install.sh | bash</code>
            <button type="button" class="copy" data-copy="#c1b" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
          <p class="way">{t.start.waySource}</p>
          <div class="cmd sm">
            <code id="c1c">git clone https://github.com/tsonglew/adhd-md &amp;&amp; cd adhd-md
bash scripts/install.sh</code>
            <button type="button" class="copy" data-copy="#c1c" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
          <p class="note-sm" set:html={t.start.noteSmHtml} />
        </li>
        <li>
          <p>{t.start.s2}</p>
          <div class="cmd sm">
            <code id="c2">npx github:tsonglew/adhd-md audit your-doc.md</code>
            <button type="button" class="copy" data-copy="#c2" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
        </li>
        <li>
          <p>{t.start.s3}</p>
          <blockquote>{t.start.quote}</blockquote>
        </li>
      </ol>

      <div class="grid-2 tail">
        <div>
          <h3>{t.start.ciH}</h3>
          <div class="cmd sm">
            <code id="c3">{t.start.ciCmd}</code>
            <button type="button" class="copy" data-copy="#c3" aria-label={t.lang === "en" ? "Copy" : "复制"}>{t.lang === "en" ? "Copy" : "复制"}</button>
          </div>
        </div>
        <div>
          <h3>{t.start.noShellH}</h3>
          <p set:html={t.start.noShellHtml} />
        </div>
      </div>
    </div>
  </div>
</section>
