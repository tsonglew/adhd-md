---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<section class="band" id="human">
  <div class="wrap sec">
    <span class="num">04</span>
    <div class="sec-body">
      <h2>{t.human.h2}</h2>
      <p class="sub">
        {t.human.sub}
      </p>

      <table class="tax">
        <thead><tr><th>{t.human.taxHead[0]}</th><th>{t.human.taxHead[1]}</th></tr></thead>
        <tbody>
          {t.human.tax.map((row) => (
            <tr><td>{row.a}</td><td>{row.b}</td></tr>
          ))}
        </tbody>
      </table>

      <div class="grid-2">
        <div>
          <h3>{t.human.grid1.h}</h3>
          <p set:html={t.human.grid1.html} />
        </div>
        <div>
          <h3>{t.human.grid2.h}</h3>
          <p set:html={t.human.grid2.html} />
        </div>
      </div>
    </div>
  </div>
</section>
