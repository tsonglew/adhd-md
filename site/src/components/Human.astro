---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<details class="reference-panel" id="human">
  <summary>{t.human.h2}</summary>
  <div class="reference-content">
      <p class="sub">
        {t.human.sub}
      </p>

      <div class="table-scroll" tabindex="0" role="region" aria-label={t.human.h2}><table class="tax">
        <thead><tr><th>{t.human.taxHead[0]}</th><th>{t.human.taxHead[1]}</th></tr></thead>
        <tbody>
          {t.human.tax.map((row) => (
            <tr><td>{row.a}</td><td>{row.b}</td></tr>
          ))}
        </tbody>
      </table></div>

      <div class="grid-2">
        <div>
          <h3>{t.human.grid1.h}</h3>
          <p set:html={t.human.grid1.html} />
        </div>
        <div>
          <h3>{t.human.grid2.h}</h3>
          <p set:html={t.human.grid2.html} />
        </div>
      </div>
  </div>
</details>
