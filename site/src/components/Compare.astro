---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<section class="band alt" id="compare">
  <div class="wrap sec">
    <span class="num">02</span>
    <div class="sec-body">
      <h2>{t.compare.h2}</h2>
      <p class="sub" set:html={t.compare.subHtml} />

      <div class="compare">
        <div class="compare-cols">
          <div class="col">
            <div class="col-head">
              <span class="col-tag">{t.compare.beforeTag}</span>
              <span class="col-score">{t.compare.scoreBefore}</span>
            </div>
            <div class="doc">
              <h3 class="doc-h1">{t.compare.docTitle}</h3>
              {t.compare.beforeParas.map((p) => <p>{p}</p>)}
            </div>
          </div>

          <div class="col">
            <div class="col-head">
              <span class="col-tag">{t.compare.afterTag}</span>
              <span class="col-score">{t.compare.scoreAfter}</span>
            </div>
            <div class="doc">
              <h3 class="doc-h1">{t.compare.docTitle}</h3>
              <p class="moved">{t.compare.after.moved}</p>
              <p>{t.compare.after.p1}</p>
              <p set:html={t.compare.after.p2Html} />
              <ul>
                {t.compare.after.list.map((li) => <li set:html={li} />)}
              </ul>
              <p>{t.compare.after.p3}</p>
              <p>{t.compare.after.p4}</p>
            </div>
          </div>
        </div>

        <div class="dims" id="dims">
          {t.compare.dims.map((d) => (
            <div class="dim" data-before={d.before} data-after={d.after}>
              <span>{d.label}</span><i class="b-before"><b></b></i><i class="b-after"><b></b></i><em></em>
            </div>
          ))}
        </div>

        <p class="compare-foot">
          {t.compare.footChanged}
          {t.compare.footWords}
        </p>
      </div>

      <p class="aside" set:html={t.compare.asideHtml} />
    </div>
  </div>
</section>
