---
import type { UI } from "../i18n/ui";
interface Props { t: UI }
const { t } = Astro.props;
---

<section class="band alt" id="lossless">
  <div class="wrap sec">
    <span class="num">05</span>
    <div class="sec-body">
      <h2>{t.lossless.h2}</h2>
      <p class="sub" set:html={t.lossless.subHtml} />

      <div class="term" role="img" aria-label={t.lossless.termAria}>
        <div class="term-bar"><span></span><span></span><span></span></div>
        <pre><code set:html={t.lossless.termHtml} /></pre>
      </div>

      <div class="grid-2">
        <div>
          <h3>{t.lossless.grid1.h}</h3>
          <p>{t.lossless.grid1.t}</p>
        </div>
        <div>
          <h3>{t.lossless.grid2.h}</h3>
          <p set:html={t.lossless.grid2.t} />
        </div>
      </div>
    </div>
  </div>
</section>
