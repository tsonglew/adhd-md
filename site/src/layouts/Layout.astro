  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Noto+Sans+SC:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>

  <header class="masthead">
    <div class="wrap masthead-in">
      <span class="wordmark">adhd-md</span>
      <nav aria-label="站内导航">
        <a href="#compare">对照</a>
