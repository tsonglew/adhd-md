<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>adhd-md — 把 Markdown 改造成读得下去的样子</title>
  <meta name="description" content="一份跨 agent 通用的 skill：把 Markdown 改造成 ADHD 友好、可扫读的版本。可只改格式、只改内容或两者兼改。只重排信息，绝不删信息。格式档的改动可被脚本证明无损。">
  <link rel="canonical" href="https://tsonglew.github.io/adhd-md/">

  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="icon" href="favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <meta name="theme-color" content="#f2efe7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#15140f" media="(prefers-color-scheme: dark)">

  <meta property="og:site_name" content="adhd-md">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:title" content="adhd-md — 把 Markdown 改造成读得下去的样子">
