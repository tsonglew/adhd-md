  <meta property="og:image" content="https://tsonglew.github.io/adhd-md/og.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="adhd-md：把 Markdown 改造成读得下去的样子。只重排信息，绝不删信息。脚本分 87.8 到 100，正文一个词都没改。">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="adhd-md — 把 Markdown 改造成读得下去的样子">
